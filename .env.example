# Application Configuration
PORT=3000
APP_NAME=NodeFlow Framework
APP_URL=http://localhost:3000
SESSION_SECRET=nodeflow_super_secret_session_key_replace_in_production
NODE_ENV=development

# Database Configuration (supports discrete vars or full DATABASE_URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=nodeflow_erp_db
# DATABASE_URL=mysql://root:@127.0.0.1:3306/nodeflow_erp_db

# Query Profiling (log queries exceeding threshold in ms)
SLOW_QUERY_THRESHOLD_MS=100

# High-Performance Hybrid Cache (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379

# JWT & API Token Security
JWT_SECRET=nodeflow_jwt_secret_key_change_me
JWT_EXPIRY=24h

# Google Gemini AI Integration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

{
  "name": "nodeflow-mvc-skeleton",
  "version": "1.0.0",
  "description": "Premium Custom Node.js Express MVC Framework Skeleton",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:install": "npm --prefix client install",
    "build": "npm --prefix client run build",
    "dev:all": "concurrently \"nodemon server.js\" \"npm --prefix client run dev\""
  },
  "keywords": [
    "express",
    "mvc",
    "mysql",
    "ejs",
    "framework"
  ],
  "author": "NodeFlow Developers",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.0",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.9.7",
    "session-file-store": "^1.5.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.0"
  }
}

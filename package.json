{
  "name": "aero-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Aero MVC - Enterprise Express 5 MVC & Next.js 14 Full-Stack Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:web": "next dev apps/web -p 3000",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "dev:all": "concurrently \"npm run dev:backend\" \"next dev apps/web -p 3000\"",
    "build": "npm run build:shared && npm run build:web",
    "build:shared": "npm --prefix packages/shared run build",
    "build:web": "next build apps/web",
    "start": "npm --prefix apps/backend run start",
    "start:web": "next start apps/web -p 3000",
    "cli": "node apps/backend/cli.js",
    "test": "npm --prefix apps/backend run test",
    "db:studio": "npm --prefix apps/backend run prisma:studio",
    "db:pull": "npm --prefix apps/backend run prisma:pull",
    "db:push": "npm --prefix apps/backend run prisma:push",
    "db:migrate": "npm --prefix apps/backend run prisma:migrate",
    "prisma:generate": "npm --prefix apps/backend run prisma:generate"
  },
  "keywords": [
    "express",
    "mvc",
    "nextjs",
    "react-native",
    "monorepo",
    "mysql",
    "framework"
  ],
  "author": "Aero Developers",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.395.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.0"
  }
}

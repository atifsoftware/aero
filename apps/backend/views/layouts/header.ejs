<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= typeof title !== 'undefined' ? title : settingsMap.name %></title>
  
  <!-- Favicon Icon -->
  <link rel="icon" type="image/x-icon" href="<%= settingsMap.favicon ? (settingsMap.favicon.startsWith('/') || settingsMap.favicon.startsWith('http') ? settingsMap.favicon : '/' + settingsMap.favicon) : '/favicon.ico' %>">
  
  <!-- Google Fonts ('Hind Siliguri' & 'Inter') -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS & FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Modern Stylings -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Alpine.js Core Script (Universal client reactivity) -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body>

  <!-- Premium Global Navbar -->
  <nav class="navbar" style="background-color: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 1rem 0;">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="logo-group">
        <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
          <% if (settingsMap.logo) { %>
            <img src="/<%= settingsMap.logo %>" alt="Logo" style="height: 36px; max-width: 130px; object-fit: contain; border-radius: 4px;">
          <% } else { %>
            <img src="/img/aero_logo.jpg" alt="Aero MVC" style="height: 36px; width: 36px; object-fit: cover; border-radius: 8px; box-shadow: 0 0 10px rgba(14, 165, 233, 0.35);">
          <% } %>
          <span class="logo-text" style="font-weight: 700; font-size: 1.25rem; color: var(--text-main); font-family: 'Inter';"><%= settingsMap.short_name || settingsMap.name || 'Aero' %></span>
        </a>
      </div>
      
      <% if (user) { %>
        <div class="nav-links d-flex align-items-center gap-3">
          <a href="/admin/dashboard" class="nav-link" style="color: var(--text-secondary); text-decoration: none; font-weight: 500; font-family: 'Hind Siliguri';">ড্যাশবোর্ড</a>
          <div class="nav-user d-flex align-items-center gap-2">
            <span class="user-badge" style="background: rgba(14,165,233,0.1); color: #0ea5e9; padding: 0.35rem 0.75rem; border-radius: 12px; font-size: 0.85rem; font-weight: 600;"><%= (user && user.name) ? user.name : 'User' %></span>
            <a href="/logout" class="btn btn-danger" style="padding: 0.35rem 0.85rem; font-size: 0.8rem; border-radius: 8px; font-family: 'Hind Siliguri';">লগআউট</a>
          </div>
        </div>
      <% } else { %>
        <div class="nav-links">
          <a href="/login" class="btn btn-primary" style="background: #0ea5e9; border: none; padding: 0.45rem 1.25rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600; font-family: 'Hind Siliguri';">লগইন</a>
        </div>
      <% } %>
    </div>
  </nav>

  <div class="container animate-fade-in" style="margin-top: 2.5rem;">

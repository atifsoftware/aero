<%- include('../layouts/header') %>

    <div class=row justify-content-center animate-fade-in style=margin-top: 2.5rem; margin-bottom: 5rem;>
        <div class=col-md-5 col-lg-4>
            <div class=card
                style=background: var(--card-bg, #1e293b); border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1)); padding: 2.5rem 2.25rem; border-radius: 24px; box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.4);>
                
                <div class=text-center mb-4>
                    <div class=brand-icon mb-3
                        style=width: 58px; height: 58px; border-radius: 16px; background: linear-gradient(135deg, #ff6d00, #ff851b); display: inline-flex; align-items: center; justify-content: center; color: white; font-size: 1.6rem; box-shadow: 0 10px 25px -4px rgba(255, 109, 0, 0.4);>
                        <i class=fas fa-shield-halved></i>
                    </div>
                    <div class=mb-2>
                        <span style=display: inline-flex; align-items: center; gap: 6px; padding: 2px 12px; border-radius: 9999px; font-size: 11px; font-weight: 700; background: rgba(255, 109, 0, 0.12); color: #ff6d00; border: 1px solid rgba(255, 109, 0, 0.25); text-transform: uppercase;>
                            <i class=fas fa-lock style=font-size: 10px;></i>
                            নিরাপদ অ্যাডমিন পোর্টাল
                        </span>
                    </div>
                    <h3 style=font-weight: 800; color: var(--text-main, #ffffff); font-family: 'Hind Siliguri'; font-size: 1.6rem; margin-bottom: 0.25rem;>
                        অ্যাডমিন <span style=color: #ff6d00;>লগইন</span>
                    </h3>
                    <p style=color: var(--text-muted, #94a3b8); font-size: 0.9rem; font-family: 'Hind Siliguri'; margin-bottom: 0;>
                        Aero MVC কন্ট্রোল প্যানেলে প্রবেশ করতে আপনার তথ্য দিন
                    </p>
                </div>

                <% if (locals.flash_error) { %>
                    <div class=alert alert-danger d-flex align-items-center gap-2
                        style=border-radius: 12px; font-size: 0.9rem; font-family: 'Hind Siliguri'; border-left: 4px solid #f43f5e; background: rgba(244, 63, 94, 0.12); color: #f43f5e; padding: 0.85rem 1rem;>
                        <i class=fas fa-circle-exclamation fs-5 flex-shrink-0></i>
                        <div><%= flash_error %></div>
                    </div>
                <% } %>

                <% if (locals.flash_success) { %>
                    <div class=alert alert-success d-flex align-items-center gap-2
                        style=border-radius: 12px; font-size: 0.9rem; font-family: 'Hind Siliguri'; border-left: 4px solid #10b981; background: rgba(16, 185, 129, 0.12); color: #10b981; padding: 0.85rem 1rem;>
                        <i class=fas fa-circle-check fs-5 flex-shrink-0></i>
                        <div><%= flash_success %></div>
                    </div>
                <% } %>

                <form action=/login method=POST id=loginForm
                    style=display: flex; flex-direction: column; gap: 1.2rem;>
                    <input type=hidden name=_csrf value=<%= csrfToken %>>

                    <div class=form-group style=display: flex; flex-direction: column; gap: 0.45rem;>
                        <label style=color: var(--text-main, #cbd5e1); font-weight: 600; font-size: 0.88rem; font-family: 'Hind Siliguri';>ইউজারনেম অথবা ইমেইল</label>
                        <div style=position: relative; display: flex; align-items: center;>
                            <i class=fas fa-user style=position: absolute; left: 14px; color: #94a3b8; font-size: 14px;></i>
                            <input type=text name=username id=loginUsername required placeholder=admin
                                value=admin
                                style=width: 100%; height: 46px; background: rgba(15, 23, 42, 0.6); border: 1.5px solid rgba(255, 255, 255, 0.1); padding: 0.65rem 1rem 0.65rem 40px; border-radius: 12px; color: white; font-family: 'Inter'; outline: none;>
                        </div>
                    </div>

                    <div class=form-group style=display: flex; flex-direction: column; gap: 0.45rem;>
                        <label style=color: var(--text-main, #cbd5e1); font-weight: 600; font-size: 0.88rem; font-family: 'Hind Siliguri';>পাসওয়ার্ড</label>
                        <div style=position: relative; display: flex; align-items: center;>
                            <i class=fas fa-lock style=position: absolute; left: 14px; color: #94a3b8; font-size: 14px;></i>
                            <input type=password name=password id=loginPassword required placeholder=••••••••
                                value=admin123
                                style=width: 100%; height: 46px; background: rgba(15, 23, 42, 0.6); border: 1.5px solid rgba(255, 255, 255, 0.1); padding: 0.65rem 42px 0.65rem 40px; border-radius: 12px; color: white; font-family: 'Inter'; outline: none;>
                            <button type=button onclick=const p = document.getElementById('loginPassword'); const i = this.querySelector('i'); if (p.type === 'password') { p.type = 'text'; i.className = 'fas fa-eye-slash'; } else { p.type = 'password'; i.className = 'fas fa-eye'; } style=position: absolute; right: 12px; background: none; border: none; color: #94a3b8; cursor: pointer; padding: 4px;>
                                <i class=fas fa-eye></i>
                            </button>
                        </div>
                    </div>

                    <div style=display: flex; justify-content: space-between; align-items: center; font-size: 0.86rem; color: #94a3b8; font-family: 'Hind Siliguri';>
                        <label style=display: flex; align-items: center; gap: 6px; cursor: pointer; margin: 0;>
                            <input type=checkbox checked style=accent-color: #ff6d00;>
                            আমাকে মনে রাখুন
                        </label>
                        <a href=javascript:void(0) onclick=alert('পাসওয়ার্ড রিকভারির জন্য সিস্টেম অ্যাডমিনের সাথে যোগাযোগ করুন।') style=color: #ff6d00; text-decoration: none; font-weight: 600;>পাসওয়ার্ড ভুলে গেছেন?</a>
                    </div>

                    <button type=submit class=btn
                        style=background: linear-gradient(135deg, #ff6d00, #ff851b); border: none; height: 48px; border-radius: 12px; font-weight: 700; color: white; font-family: 'Hind Siliguri'; font-size: 1rem; box-shadow: 0 6px 20px -3px rgba(255, 109, 0, 0.4); display: flex; align-items: center; justify-content: center; gap: 8px;>
                        <span>লগইন করুন</span>
                        <i class=fas fa-arrow-right style=font-size: 0.9rem;></i>
                    </button>
                </form>

                <div class=mt-4 p-3
                    style=border-radius: 14px; background: rgba(255, 109, 0, 0.06); border: 1px dashed rgba(255, 109, 0, 0.25); font-family: 'Hind Siliguri';>
                    <div style=display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;>
                        <span style=font-size: 0.8rem; font-weight: 700; color: #94a3b8; text-transform: uppercase;>
                            <i class=fas fa-key me-1 style=color: #ff6d00;></i> ডেমো ক্রেডেনশিয়াল
                        </span>
                        <button type=button onclick=document.getElementById('loginUsername').value='admin'; document.getElementById('loginPassword').value='admin123'; this.innerText='পূরণ হয়েছে!';
                            style=background: rgba(255, 109, 0, 0.15); color: #ff6d00; border: 1px solid rgba(255, 109, 0, 0.3); padding: 2px 10px; border-radius: 9999px; font-size: 11px; font-weight: 700; cursor: pointer;>
                            <i class=fas fa-bolt me-1></i> অটো-ফিল
                        </button>
                    </div>
                    <div style=display: flex; justify-content: space-between; font-size: 0.85rem; color: #cbd5e1; background: rgba(15, 23, 42, 0.4); padding: 5px 10px; border-radius: 8px;>
                        <span>ইউজার: <strong style=color: white; font-family: 'Inter';>admin</strong></span>
                        <span style=color: #64748b;>|</span>
                        <span>পাসওয়ার্ড: <strong style=color: white; font-family: 'Inter';>admin123</strong></span>
                    </div>
                </div>

                <div class=text-center mt-3>
                    <a href=/ style=display: inline-flex; align-items: center; gap: 6px; color: #94a3b8; font-size: 0.88rem; font-family: 'Hind Siliguri'; text-decoration: none; font-weight: 600;>
                        <i class=fas fa-arrow-left></i> মূল পাতায় ফিরে যান
                    </a>
                </div>
            </div>
        </div>
    </div>

<%- include('../layouts/footer') %>

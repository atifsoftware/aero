<%- include('layouts/header') %>

<!-- Hero Showcase Banner -->
<div class="card animate-fade-in" style="background: radial-gradient(circle at center, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.6) 100%); border: 1px solid rgba(255, 255, 255, 0.08); padding: 4.5rem 2rem; text-align: center; margin-bottom: 2.5rem; position: relative; overflow: hidden; border-radius: 24px;">
    <div style="position: absolute; width: 300px; height: 300px; background: rgba(14, 165, 233, 0.15); filter: blur(80px); top: -50px; left: 10%; border-radius: 50%; pointer-events: none;"></div>
    <div style="position: absolute; width: 300px; height: 300px; background: rgba(16, 185, 129, 0.15); filter: blur(80px); bottom: -50px; right: 10%; border-radius: 50%; pointer-events: none;"></div>

    <div style="position: relative; z-index: 10; max-width: 800px; margin: 0 auto;">
        <span class="badge" style="padding: 0.5rem 1rem; border-radius: 20px; font-weight: 700; font-size: 0.75rem; letter-spacing: 1px; margin-bottom: 1.5rem; text-transform: uppercase; background: rgba(14, 165, 233, 0.1); color: #0ea5e9;">
            <i class="fas fa-rocket me-1"></i> Aero MVC Framework v1.0.0
        </span>
        
        <h1 style="font-size: 3.25rem; font-weight: 800; line-height: 1.2; margin-bottom: 1.5rem; background: linear-gradient(135deg, #ffffff 30%, #94a3b8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-family: 'Hind Siliguri', sans-serif;">
            স্বাগতম <span style="background: linear-gradient(135deg, #0ea5e9, #10b981); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Aero MVC</span> ফ্রেমওয়ার্ক এ
        </h1>
        
        <p style="color: var(--text-secondary); font-size: 1.15rem; line-height: 1.7; margin-bottom: 2.5rem; font-family: 'Hind Siliguri', sans-serif;">
            একটি শক্তিশালী, মডার্ন এবং অতি দ্রুতগতির Node.js এক্সপ্রেস MVC ফ্রেমওয়ার্ক। এটি আপনার এন্টারপ্রাইজ ওয়েব অ্যাপ্লিকেশন এবং ডেটাবেজ ডেভেলপমেন্টকে করবে নিরাপদ, সহজ এবং অত্যন্ত প্রফেশনাল।
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <% if (user) { %>
                <a href="/admin/dashboard" class="btn btn-primary animate-hover" style="background-color: #0ea5e9; border: none; font-weight: 600; padding: 0.8rem 2rem; border-radius: 30px; font-size: 1rem; font-family: 'Hind Siliguri'; box-shadow: 0 0 15px rgba(14, 165, 233, 0.4);">
                    <i class="fas fa-tachometer-alt me-2"></i> অ্যাডমিন ড্যাশবোর্ড
                </a>
            <% } else { %>
                <a href="/login" class="btn btn-primary animate-hover" style="background-color: #0ea5e9; border: none; font-weight: 600; padding: 0.8rem 2rem; border-radius: 30px; font-size: 1rem; font-family: 'Hind Siliguri'; box-shadow: 0 0 15px rgba(14, 165, 233, 0.4);">
                    <i class="fas fa-sign-in-alt me-2"></i> লগইন করুন
                </a>
            <% } %>
        </div>
    </div>
</div>

<!-- Key Features Grid -->
<div class="row g-4 animate-fade-in" style="margin-bottom: 3.5rem;">
    <!-- Feature 1: Fast Execution -->
    <div class="col-md-4">
        <div class="card h-100" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; background-color: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255, 255, 255, 0.05);">
            <div style="font-size: 2.25rem; color: #0ea5e9; display: flex;"><i class="fas fa-bolt"></i></div>
            <h4 style="font-size: 1.25rem; font-weight: 700; font-family: 'Hind Siliguri'; color: white; margin: 0;">অত্যন্ত দ্রুত পারফরম্যান্স</h4>
            <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin: 0; font-family: 'Hind Siliguri';">
                Node.js-এর নন-ব্লকিং অ্যাসিনক্রোনাস আর্কিটেকচার এবং আমাদের ডেটাবেজ কানেকশন পুলিং সিস্টেম নিশ্চিত করে এক মুহূর্তেই হাই-স্পিড কুয়েরি প্রসেসিং।
            </p>
        </div>
    </div>
    
    <!-- Feature 2: High Security -->
    <div class="col-md-4">
        <div class="card h-100" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; background-color: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255, 255, 255, 0.05);">
            <div style="font-size: 2.25rem; color: #10b981; display: flex;"><i class="fas fa-shield-alt"></i></div>
            <h4 style="font-size: 1.25rem; font-weight: 700; font-family: 'Hind Siliguri'; color: white; margin: 0;">নিরাপদ আর্কিটেকচার</h4>
            <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin: 0; font-family: 'Hind Siliguri';">
                অন্তর্নির্মিত CSRF প্রোটেকশন ফিল্টার, SQL ইনজেকশন ডিফেন্স, হেলমেট সিকিউর হেডার এবং অ্যান্টি-ব্রুট ফোর্স রেট লিমিটিং প্রোটোকল দ্বারা সম্পূর্ণ সুরক্ষিত।
            </p>
        </div>
    </div>
    
    <!-- Feature 3: Smart Debugger -->
    <div class="col-md-4">
        <div class="card h-100" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; background-color: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255, 255, 255, 0.05);">
            <div style="font-size: 2.25rem; color: #f59e0b; display: flex;"><i class="fas fa-bug"></i></div>
            <h4 style="font-size: 1.25rem; font-weight: 700; font-family: 'Hind Siliguri'; color: white; margin: 0;">ইন্টেলিজেন্ট ডিবাগার</h4>
            <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin: 0; font-family: 'Hind Siliguri';">
                আমাদের উন্নত ইন্টেলিজেন্ট এরর হ্যান্ডলার রিয়েল-টাইম কোড কনটেক্সট প্রিভিউ এবং Levenshtein দূরত্ব ব্যবহার করে টাইপো সাজেশন দিয়ে ডিবাগিং সময়কে কমিয়ে আনে।
            </p>
        </div>
    </div>
</div>

<%- include('layouts/footer') %>

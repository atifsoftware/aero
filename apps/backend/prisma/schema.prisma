// Aero Enterprise Prisma Schema
// Prisma ORM Layer - Coexists with Custom Fluent Query Builder (config/db.js)

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. Authentication & Security
// -------------------------------------------------------------

model User {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(255)
  email               String                @unique @db.VarChar(255)
  password            String                @db.VarChar(255)
  role                String                @default("staff") @db.VarChar(50)
  status              Int                   @default(1) @db.TinyInt
  createdAt           DateTime?             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime?             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  personalAccessTokens PersonalAccessToken[]

  @@map("users")
}

model PersonalAccessToken {
  id            Int       @id @default(autoincrement())
  tokenableType String    @map("tokenable_type") @db.VarChar(255)
  tokenableId   Int       @map("tokenable_id")
  name          String    @db.VarChar(255)
  token         String    @unique @db.VarChar(64)
  abilities     String?   @db.Text
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamp(0)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user          User?     @relation(fields: [tokenableId], references: [id], onDelete: Cascade)

  @@index([tokenableId], map: "tokenable_id_idx")
  @@map("personal_access_tokens")
}

model Role {
  id          Int              @id @default(autoincrement())
  roleKey     String           @unique @map("role_key") @db.VarChar(50)
  roleName    String           @map("role_name") @db.VarChar(100)
  description String?          @db.VarChar(255)
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id             Int              @id @default(autoincrement())
  permissionKey  String           @unique @map("permission_key") @db.VarChar(100)
  permissionName String           @map("permission_name") @db.VarChar(100)
  description    String?          @db.VarChar(255)
  roles          RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

// -------------------------------------------------------------
// 2. Organization & Shops
// -------------------------------------------------------------

model Shop {
  id        Int       @id @default(autoincrement())
  shopName  String    @map("shop_name") @db.VarChar(255)
  address   String?   @db.Text
  phone     String?   @db.VarChar(50)
  orderNo   Int       @default(0) @map("order_no")
  status    Int       @default(1) @db.TinyInt
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("shops")
}

// -------------------------------------------------------------
// 3. Financial Vouchers & Accounts
// -------------------------------------------------------------

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  type      String    @default("expense") @db.VarChar(50) // expense or income
  status    Int       @default(1) @db.TinyInt
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  vouchers  Voucher[]

  @@map("categories")
}

model Account {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  accountNumber String?   @map("account_number") @db.VarChar(100)
  balance       Decimal   @default(0.00) @db.Decimal(15, 2)
  status        Int       @default(1) @db.TinyInt
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  vouchers      Voucher[]

  @@map("accounts")
}

model Voucher {
  id         Int       @id @default(autoincrement())
  voucherNo  String?   @map("voucher_no") @db.VarChar(100)
  type       String    @db.VarChar(50) // expense or income
  categoryId Int       @map("category_id")
  accountId  Int       @map("account_id")
  amount     Decimal   @db.Decimal(15, 2)
  note       String?   @db.Text
  date       DateTime  @db.Date
  shopId     Int?      @map("shop_id")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  category   Category  @relation(fields: [categoryId], references: [id])
  account    Account   @relation(fields: [accountId], references: [id])

  @@map("vouchers")
}

// -------------------------------------------------------------
// 4. Customer & Supplier Tally Khata
// -------------------------------------------------------------

model Customer {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  phone          String?          @db.VarChar(50)
  email          String?          @db.VarChar(100)
  address        String?          @db.Text
  openingBalance Decimal          @default(0.00) @map("opening_balance") @db.Decimal(15, 2)
  currentBalance Decimal          @default(0.00) @map("current_balance") @db.Decimal(15, 2)
  status         Int              @default(1) @db.TinyInt
  createdAt      DateTime?        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  ledgers        CustomerLedger[]

  @@map("customers")
}

model CustomerLedger {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  type       String    @db.VarChar(20) // debit or credit
  amount     Decimal   @db.Decimal(15, 2)
  note       String?   @db.Text
  date       DateTime  @db.Date
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_ledgers")
}

model Supplier {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  phone          String?          @db.VarChar(50)
  email          String?          @db.VarChar(100)
  company        String?          @db.VarChar(255)
  address        String?          @db.Text
  openingBalance Decimal          @default(0.00) @map("opening_balance") @db.Decimal(15, 2)
  currentBalance Decimal          @default(0.00) @map("current_balance") @db.Decimal(15, 2)
  status         Int              @default(1) @db.TinyInt
  createdAt      DateTime?        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  ledgers        SupplierLedger[]

  @@map("suppliers")
}

model SupplierLedger {
  id         Int       @id @default(autoincrement())
  supplierId Int       @map("supplier_id")
  type       String    @db.VarChar(20) // debit or credit
  amount     Decimal   @db.Decimal(15, 2)
  note       String?   @db.Text
  date       DateTime  @db.Date
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_ledgers")
}

// -------------------------------------------------------------
// 5. HR, Payroll & Attendance
// -------------------------------------------------------------

model Employee {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(255)
  designation String?      @db.VarChar(100)
  phone       String?      @db.VarChar(50)
  salary      Decimal      @default(0.00) @db.Decimal(15, 2)
  joinDate    DateTime?    @map("join_date") @db.Date
  status      Int          @default(1) @db.TinyInt
  createdAt   DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  advances    Advance[]
  salaries    Salary[]
  attendances Attendance[]

  @@map("employees")
}

model Advance {
  id         Int       @id @default(autoincrement())
  employeeId Int       @map("employee_id")
  amount     Decimal   @db.Decimal(15, 2)
  reason     String?   @db.Text
  date       DateTime  @db.Date
  isRepaid   Int       @default(0) @map("is_repaid") @db.TinyInt
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("advances")
}

model Salary {
  id               Int       @id @default(autoincrement())
  employeeId       Int       @map("employee_id")
  month            String    @db.VarChar(20)
  year             Int
  basicSalary      Decimal   @map("basic_salary") @db.Decimal(15, 2)
  advanceDeduction Decimal   @default(0.00) @map("advance_deduction") @db.Decimal(15, 2)
  netPaid          Decimal   @map("net_paid") @db.Decimal(15, 2)
  date             DateTime  @db.Date
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salaries")
}

model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int       @map("employee_id")
  date       DateTime  @db.Date
  status     String    @default("present") @db.VarChar(20) // present, absent, late, leave
  inTime     String?   @map("in_time") @db.VarChar(20)
  outTime    String?   @map("out_time") @db.VarChar(20)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

// -------------------------------------------------------------
// 6. System, Queue, Logs & Settings
// -------------------------------------------------------------

model ActivityLog {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  userName  String    @default("Guest") @map("user_name") @db.VarChar(255)
  action    String    @db.VarChar(255)
  description String  @db.Text
  ipAddress String    @map("ip_address") @db.VarChar(45)
  userAgent String    @map("user_agent") @db.Text
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("activity_logs")
}

model Setting {
  id           Int     @id @default(autoincrement())
  settingKey   String  @unique @map("setting_key") @db.VarChar(255)
  settingValue String? @map("setting_value") @db.Text

  @@map("settings")
}

model FailedJob {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @db.VarChar(255)
  connection  String    @default("mysql") @db.VarChar(255)
  queue       String    @default("default") @db.VarChar(255)
  displayName String    @map("display_name") @db.VarChar(255)
  payload     String    @db.LongText
  exception   String    @db.LongText
  failedAt    DateTime? @default(now()) @map("failed_at") @db.Timestamp(0)

  @@map("failed_jobs")
}

# Application Configuration
PORT=3000
APP_NAME=Aero MVC Framework
APP_URL=http://localhost:3000
SESSION_SECRET=aero_super_secret_session_key_replace_in_production
NODE_ENV=development
# Comma-separated list of allowed CORS origins (no wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (supports discrete vars or full DATABASE_URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=nodeflow_erp_db
# DATABASE_URL=mysql://root:@127.0.0.1:3306/nodeflow_erp_db

# Query Profiling (log queries exceeding threshold in ms)
SLOW_QUERY_THRESHOLD_MS=100

# High-Performance Hybrid Cache (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379

# JWT & API Token Security
JWT_SECRET=aero_jwt_secret_key_change_me
JWT_EXPIRY=24h

# Google Gemini AI Integration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Enterprise Email Configuration (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_username
MAIL_PASS=your_smtp_password
MAIL_FROM_ADDRESS=noreply@aeromvc.local
MAIL_FROM_NAME="Aero MVC Engine"

# Enterprise SMS Gateway Configuration (twilio | webhook | mock)
SMS_PROVIDER=mock
# Twilio Provider Settings
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# Webhook Provider Settings
SMS_WEBHOOK_URL=https://api.sms-provider.com/v1/send
SMS_API_KEY=your_sms_api_key

